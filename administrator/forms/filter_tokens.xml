<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="GrantHood\Component\DownloadTracker\Administrator\Field">
	<fields name="filter">
		<field name="search" type="text" label="COM_DOWNLOADTRACKER_FILTER_SEARCH_LABEL" description="COM_DOWNLOADTRACKER_FILTER_TOKENS_SEARCH_DESC" hint="JSEARCH_FILTER" />
		<field name="state" type="list" label="JSTATUS" onchange="this.form.submit();" validate="options">
			<option value="">JOPTION_SELECT_PUBLISHED</option>
			<option value="*">JALL</option>
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
			<option value="-2">JTRASHED</option>
		</field>
		<field name="item_id" type="item" label="COM_DOWNLOADTRACKER_FIELD_ITEM_LABEL" onchange="this.form.submit();">
			<option value="">COM_DOWNLOADTRACKER_SELECT_ITEM</option>
		</field>
	</fields>
	<fields name="list">
		<field name="fullordering" type="list" label="JGLOBAL_SORT_BY" onchange="this.form.submit();" default="a.created DESC" validate="options">
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="a.label ASC">COM_DOWNLOADTRACKER_TOKEN_LABEL_ASC</option>
			<option value="a.label DESC">COM_DOWNLOADTRACKER_TOKEN_LABEL_DESC</option>
			<option value="i.title ASC">COM_DOWNLOADTRACKER_ITEM_ASC</option>
			<option value="i.title DESC">COM_DOWNLOADTRACKER_ITEM_DESC</option>
			<option value="a.customer_email ASC">COM_DOWNLOADTRACKER_CUSTOMER_EMAIL_ASC</option>
			<option value="a.customer_email DESC">COM_DOWNLOADTRACKER_CUSTOMER_EMAIL_DESC</option>
			<option value="a.expires_at ASC">COM_DOWNLOADTRACKER_EXPIRES_AT_ASC</option>
			<option value="a.expires_at DESC">COM_DOWNLOADTRACKER_EXPIRES_AT_DESC</option>
			<option value="a.last_used_at ASC">COM_DOWNLOADTRACKER_LAST_USED_AT_ASC</option>
			<option value="a.last_used_at DESC">COM_DOWNLOADTRACKER_LAST_USED_AT_DESC</option>
			<option value="a.created ASC">JDATE_ASC</option>
			<option value="a.created DESC">JDATE_DESC</option>
			<option value="a.state ASC">JSTATUS_ASC</option>
			<option value="a.state DESC">JSTATUS_DESC</option>
		</field>
		<field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" default="25" onchange="this.form.submit();" />
	</fields>
</form>
