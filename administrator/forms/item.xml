<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="GrantHood\Component\DownloadTracker\Administrator\Field">
	<fieldset name="details">
		<field name="id" type="hidden" />
		<field name="product_id" type="product" label="COM_DOWNLOADTRACKER_FIELD_PRODUCT_LABEL" required="true">
			<option value="">COM_DOWNLOADTRACKER_SELECT_PRODUCT</option>
		</field>
		<field name="title" type="text" label="COM_DOWNLOADTRACKER_FIELD_TITLE_LABEL" required="true" maxlength="255" />
		<field name="alias" type="text" label="COM_DOWNLOADTRACKER_FIELD_ALIAS_LABEL" maxlength="255" hint="COM_DOWNLOADTRACKER_FIELD_ALIAS_HINT" />
		<field name="edition" type="text" label="COM_DOWNLOADTRACKER_FIELD_EDITION_LABEL" maxlength="50" />
		<field name="version" type="text" label="COM_DOWNLOADTRACKER_FIELD_VERSION_LABEL" maxlength="50" />
		<field name="source_type" type="radio" label="COM_DOWNLOADTRACKER_FIELD_SOURCE_TYPE_LABEL" default="external" validate="options">
			<option value="external">COM_DOWNLOADTRACKER_OPTION_SOURCE_EXTERNAL</option>
			<option value="private_file">COM_DOWNLOADTRACKER_OPTION_SOURCE_PRIVATE_FILE</option>
		</field>
		<field name="target_url" type="url" label="COM_DOWNLOADTRACKER_FIELD_TARGET_URL_LABEL" filter="url" showon="source_type:external" />
		<field
			name="private_file"
			type="text"
			label="COM_DOWNLOADTRACKER_FIELD_PRIVATE_FILE_LABEL"
			description="COM_DOWNLOADTRACKER_FIELD_PRIVATE_FILE_DESC"
			filter="string"
			showon="source_type:private_file"
		/>
		<field
			name="requires_token"
			type="radio"
			label="COM_DOWNLOADTRACKER_FIELD_REQUIRES_TOKEN_LABEL"
			description="COM_DOWNLOADTRACKER_FIELD_REQUIRES_TOKEN_DESC"
			layout="joomla.form.field.radio.switcher"
			default="0"
		>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field name="is_latest" type="radio" label="COM_DOWNLOADTRACKER_FIELD_IS_LATEST_LABEL" layout="joomla.form.field.radio.switcher" default="0">
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field name="state" type="list" label="JSTATUS" default="1" validate="options">
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
			<option value="-2">JTRASHED</option>
		</field>
		<field name="notes" type="textarea" label="COM_DOWNLOADTRACKER_FIELD_NOTES_LABEL" rows="6" filter="safehtml" />
	</fieldset>
	<fieldset name="updates" label="COM_DOWNLOADTRACKER_FIELDSET_UPDATES_LABEL">
		<field
			name="update_enabled"
			type="radio"
			label="COM_DOWNLOADTRACKER_FIELD_UPDATE_ENABLED_LABEL"
			description="COM_DOWNLOADTRACKER_FIELD_UPDATE_ENABLED_DESC"
			layout="joomla.form.field.radio.switcher"
			default="0"
			filter="integer"
		>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field name="update_element" type="text" label="COM_DOWNLOADTRACKER_FIELD_UPDATE_ELEMENT_LABEL" description="COM_DOWNLOADTRACKER_FIELD_UPDATE_ELEMENT_DESC" maxlength="255" showon="update_enabled:1" />
		<field name="update_type" type="list" label="COM_DOWNLOADTRACKER_FIELD_UPDATE_TYPE_LABEL" default="package" showon="update_enabled:1" validate="options">
			<option value="package">COM_DOWNLOADTRACKER_OPTION_UPDATE_TYPE_PACKAGE</option>
			<option value="component">COM_DOWNLOADTRACKER_OPTION_UPDATE_TYPE_COMPONENT</option>
			<option value="plugin">COM_DOWNLOADTRACKER_OPTION_UPDATE_TYPE_PLUGIN</option>
		</field>
		<field name="update_folder" type="text" label="COM_DOWNLOADTRACKER_FIELD_UPDATE_FOLDER_LABEL" description="COM_DOWNLOADTRACKER_FIELD_UPDATE_FOLDER_DESC" maxlength="100" showon="update_enabled:1[AND]update_type:plugin" />
		<field name="update_client" type="list" label="COM_DOWNLOADTRACKER_FIELD_UPDATE_CLIENT_LABEL" default="site" showon="update_enabled:1" validate="options">
			<option value="site">JSITE</option>
			<option value="administrator">JADMINISTRATOR</option>
		</field>
		<field name="update_sha256" type="text" label="COM_DOWNLOADTRACKER_FIELD_UPDATE_SHA256_LABEL" description="COM_DOWNLOADTRACKER_FIELD_UPDATE_SHA256_DESC" maxlength="64" showon="update_enabled:1" filter="cmd" />
		<field name="update_targetplatform" type="text" label="COM_DOWNLOADTRACKER_FIELD_UPDATE_TARGETPLATFORM_LABEL" description="COM_DOWNLOADTRACKER_FIELD_UPDATE_TARGETPLATFORM_DESC" default="[56]\\..*" maxlength="100" showon="update_enabled:1" filter="raw" />
		<field name="update_php_minimum" type="text" label="COM_DOWNLOADTRACKER_FIELD_UPDATE_PHP_MINIMUM_LABEL" default="8.1" maxlength="20" showon="update_enabled:1" />
	</fieldset>
</form>
