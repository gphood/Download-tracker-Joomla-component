<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="GrantHood\Component\DownloadTracker\Administrator\Field">
	<fields name="filter">
		<field name="search" type="text" label="COM_DOWNLOADTRACKER_FILTER_SEARCH_LABEL" description="COM_DOWNLOADTRACKER_FILTER_ITEMS_SEARCH_DESC" hint="JSEARCH_FILTER" />
		<field name="state" type="list" label="JSTATUS" onchange="this.form.submit();" validate="options">
			<option value="">JOPTION_SELECT_PUBLISHED</option>
			<option value="*">JALL</option>
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
			<option value="-2">JTRASHED</option>
		</field>
		<field name="product_id" type="product" label="COM_DOWNLOADTRACKER_FIELD_PRODUCT_LABEL" onchange="this.form.submit();">
			<option value="">COM_DOWNLOADTRACKER_SELECT_PRODUCT</option>
		</field>
		<field name="edition" type="text" label="COM_DOWNLOADTRACKER_FIELD_EDITION_LABEL" onchange="this.form.submit();" />
		<field name="version" type="text" label="COM_DOWNLOADTRACKER_FIELD_VERSION_LABEL" onchange="this.form.submit();" />
	</fields>
	<fields name="list">
		<field name="fullordering" type="list" label="JGLOBAL_SORT_BY" onchange="this.form.submit();" default="a.created DESC" validate="options">
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="a.title ASC">JGLOBAL_TITLE_ASC</option>
			<option value="a.title DESC">JGLOBAL_TITLE_DESC</option>
			<option value="p.title ASC">COM_DOWNLOADTRACKER_PRODUCT_ASC</option>
			<option value="p.title DESC">COM_DOWNLOADTRACKER_PRODUCT_DESC</option>
			<option value="a.created ASC">JDATE_ASC</option>
			<option value="a.created DESC">JDATE_DESC</option>
			<option value="a.state ASC">JSTATUS_ASC</option>
			<option value="a.state DESC">JSTATUS_DESC</option>
		</field>
		<field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" default="25" onchange="this.form.submit();" />
	</fields>
</form>
