<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
	<name>PLG_SYSTEM_DOWNLOADTRACKERSTRIPE</name>
	<author>Grant Hood</author>
	<creationDate>2026-06-02</creationDate>
	<copyright>(C) 2026 Grant Hood. All rights reserved.</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<version>0.1.29</version>
	<description>PLG_SYSTEM_DOWNLOADTRACKERSTRIPE_XML_DESCRIPTION</description>
	<namespace path="src">GrantHood\Plugin\System\DownloadTrackerStripe</namespace>

	<files>
		<folder plugin="downloadtrackerstripe">services</folder>
		<folder>src</folder>
	</files>

	<languages folder="language">
		<language tag="en-GB">en-GB/plg_system_downloadtrackerstripe.ini</language>
		<language tag="en-GB">en-GB/plg_system_downloadtrackerstripe.sys.ini</language>
	</languages>

	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="enabled_webhook"
					type="radio"
					label="PLG_SYSTEM_DOWNLOADTRACKERSTRIPE_FIELD_ENABLED_WEBHOOK_LABEL"
					description="PLG_SYSTEM_DOWNLOADTRACKERSTRIPE_FIELD_ENABLED_WEBHOOK_DESC"
					default="1"
					layout="joomla.form.field.radio.switcher"
					filter="integer"
					>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field
					name="webhook_secret"
					type="password"
					label="PLG_SYSTEM_DOWNLOADTRACKERSTRIPE_FIELD_WEBHOOK_SECRET_LABEL"
					description="PLG_SYSTEM_DOWNLOADTRACKERSTRIPE_FIELD_WEBHOOK_SECRET_DESC"
					filter="raw"
				/>
				<field
					name="mode"
					type="list"
					label="PLG_SYSTEM_DOWNLOADTRACKERSTRIPE_FIELD_MODE_LABEL"
					description="PLG_SYSTEM_DOWNLOADTRACKERSTRIPE_FIELD_MODE_DESC"
					default="test"
					validate="options"
					>
					<option value="test">PLG_SYSTEM_DOWNLOADTRACKERSTRIPE_MODE_TEST</option>
					<option value="live">PLG_SYSTEM_DOWNLOADTRACKERSTRIPE_MODE_LIVE</option>
					<option value="both">PLG_SYSTEM_DOWNLOADTRACKERSTRIPE_MODE_BOTH</option>
				</field>
				<field
					name="metadata_item_key"
					type="text"
					label="PLG_SYSTEM_DOWNLOADTRACKERSTRIPE_FIELD_METADATA_ITEM_KEY_LABEL"
					description="PLG_SYSTEM_DOWNLOADTRACKERSTRIPE_FIELD_METADATA_ITEM_KEY_DESC"
					default="downloadtracker_item_id"
					filter="string"
				/>
				<field
					name="default_max_uses"
					type="number"
					label="PLG_SYSTEM_DOWNLOADTRACKERSTRIPE_FIELD_DEFAULT_MAX_USES_LABEL"
					description="PLG_SYSTEM_DOWNLOADTRACKERSTRIPE_FIELD_DEFAULT_MAX_USES_DESC"
					default="3"
					min="1"
					filter="integer"
				/>
				<field
					name="default_expiry_days"
					type="number"
					label="PLG_SYSTEM_DOWNLOADTRACKERSTRIPE_FIELD_DEFAULT_EXPIRY_DAYS_LABEL"
					description="PLG_SYSTEM_DOWNLOADTRACKERSTRIPE_FIELD_DEFAULT_EXPIRY_DAYS_DESC"
					min="1"
					filter="integer"
				/>
				<field
					name="require_paid_status"
					type="radio"
					label="PLG_SYSTEM_DOWNLOADTRACKERSTRIPE_FIELD_REQUIRE_PAID_STATUS_LABEL"
					description="PLG_SYSTEM_DOWNLOADTRACKERSTRIPE_FIELD_REQUIRE_PAID_STATUS_DESC"
					default="1"
					layout="joomla.form.field.radio.switcher"
					filter="integer"
					>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field
					name="handle_async_payment_succeeded"
					type="radio"
					label="PLG_SYSTEM_DOWNLOADTRACKERSTRIPE_FIELD_HANDLE_ASYNC_PAYMENT_SUCCEEDED_LABEL"
					description="PLG_SYSTEM_DOWNLOADTRACKERSTRIPE_FIELD_HANDLE_ASYNC_PAYMENT_SUCCEEDED_DESC"
					default="0"
					layout="joomla.form.field.radio.switcher"
					filter="integer"
					>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field
					name="signature_tolerance"
					type="number"
					label="PLG_SYSTEM_DOWNLOADTRACKERSTRIPE_FIELD_SIGNATURE_TOLERANCE_LABEL"
					description="PLG_SYSTEM_DOWNLOADTRACKERSTRIPE_FIELD_SIGNATURE_TOLERANCE_DESC"
					default="300"
					min="1"
					filter="integer"
				/>
				<field
					name="debug_logging"
					type="radio"
					label="PLG_SYSTEM_DOWNLOADTRACKERSTRIPE_FIELD_DEBUG_LOGGING_LABEL"
					description="PLG_SYSTEM_DOWNLOADTRACKERSTRIPE_FIELD_DEBUG_LOGGING_DESC"
					default="0"
					layout="joomla.form.field.radio.switcher"
					filter="integer"
					>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
